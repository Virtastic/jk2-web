# syntax=docker/dockerfile:1
# =============================================================================================
# Self-contained TEST image for jk2.dev.virtastic.app (built on Jenkins, deployed to the test VM).
#
# Unlike the thin production Dockerfile (which PACKAGES a prebuilt play/jk2/ tree), this COMPILES
# the engine and the game module from source inside the pinned emscripten toolchain, so the test
# server always reflects the exact tree that was synced to the builder — no "works on my laptop"
# gap. jk2 is pure C++ and single-threaded (no Rust, no -pthread), so the toolchain image is just
# emscripten/emsdk:6.0.1 with nothing added.
#
# NO GAME DATA is ever copied: the builder stage takes only games/ + shared/, and the runtime stage
# takes only the two HTML pages plus the built artifacts. Commercial .pk3s live under play/jk2/base/
# and are additionally blocked by .dockerignore. The deployed site is bring-your-own / cloud, exactly
# like production (docker-compose.prod.yml).
# =============================================================================================

# ---- builder: compile engine + game module to wasm ------------------------------------------
FROM emscripten/emsdk:6.0.1 AS builder
WORKDIR /src
# Only the inputs the build actually reads. Copying the HTML here would make an edit to a page bust
# this (slow) compile layer, so the pages are taken from context in the runtime stage instead.
COPY games/jk2 /src/games/jk2
COPY shared    /src/shared
# build-jk2.sh        -> play/jk2/{jk2.js,jk2.wasm}   (MAIN_MODULE engine)
# build-jk2-modules.sh -> play/jk2/qagame.wasm         (SIDE_MODULE game/cgame/Icarus)
# env.sh finds emcc on PATH (the base image provides emcc 6.0.1 + python3 + node). The cache mount
# keeps the object dir warm so an incremental push recompiles only what changed.
RUN --mount=type=cache,id=jk2-build,target=/src/build-jk2 \
    bash shared/wasm-build/build-jk2.sh \
 && bash shared/wasm-build/build-jk2-modules.sh \
 && echo "=== ERRS engine:$(wc -c < build-jk2/build.errs) modules:$(wc -c < build-jk2/modules/build.errs) ===" \
 && test ! -s build-jk2/build.errs && test ! -s build-jk2/modules/build.errs \
 && ls -la play/jk2/jk2.js play/jk2/jk2.wasm play/jk2/qagame.wasm

# ---- runtime: nginx serving the tree with the cross-origin-isolation contract ---------------
FROM nginx:1.27-alpine AS runtime
LABEL org.opencontainers.image.title="jk2-test" \
      org.opencontainers.image.description="Jedi Knight II: Jedi Outcast — WASM port (test build)" \
      org.opencontainers.image.licenses="GPL-2.0-or-later"
# The purpose-built vhost: COOP/COEP/CORP + noindex on every response. (jk2 is single-threaded and
# does not strictly need cross-origin isolation to run, but the header set is kept identical to the
# rest of the Virtastic set, and the smoke test asserts it as a "config intact" check.)
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
# Static pages from context: a fast runtime-only rebuild when they change.
COPY play/jk2/index.html play/jk2/launcher.html /usr/share/nginx/html/
# Built engine + game module from the builder stage.
COPY --from=builder /src/play/jk2/jk2.js      /usr/share/nginx/html/
COPY --from=builder /src/play/jk2/jk2.wasm    /usr/share/nginx/html/
COPY --from=builder /src/play/jk2/qagame.wasm /usr/share/nginx/html/
HEALTHCHECK --interval=30s --timeout=4s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
EXPOSE 80
